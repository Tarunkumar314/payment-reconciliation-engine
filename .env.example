# Application Configuration
APP_ENV=development
DEBUG=true
PORT=8000

# PostgreSQL Configuration
POSTGRES_USER=reconcile_user
POSTGRES_PASSWORD=reconcile_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=reconcile_db
DATABASE_URL=postgresql+asyncpg://reconcile_user:reconcile_pass@localhost:5432/reconcile_db
TEST_DATABASE_URL=postgresql+asyncpg://reconcile_user:reconcile_pass@localhost:5432/reconcile_test_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SETTLEMENT_TOPIC=settlement-events
KAFKA_DLQ_TOPIC=settlement-events-dlq

# Mock bank configuration
MOCK_BANK_URL=http://localhost:8000
MOCK_BANK_FAILURE_RATE=0.2
MOCK_BANK_DELAY_MS=100

# Settlement worker retry config
SETTLEMENT_MAX_RETRIES=3
SETTLEMENT_BASE_BACKOFF_SECONDS=1.0
