# Application Configuration
APP_ENV=development
DEBUG=true
PORT=8000

# PostgreSQL Configuration
POSTGRES_USER=reconcile_user
POSTGRES_PASSWORD=reconcile_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=reconcile_db
DATABASE_URL=postgresql+asyncpg://reconcile_user:reconcile_pass@localhost:5432/reconcile_db
TEST_DATABASE_URL=postgresql+asyncpg://reconcile_user:reconcile_pass@localhost:5432/reconcile_test_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
